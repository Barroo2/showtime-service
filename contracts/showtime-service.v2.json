{
  "openapi": "3.0.4",
  "info": {
    "title": "Showtime Service",
    "version": "v2"
  },
  "paths": {
    "/v2/films": {
      "get": {
        "tags": [
          "ApiEndpoints"
        ],
        "summary": "Alle Filme",
        "operationId": "GetFilmsV2",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FilmDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/showtimes": {
      "get": {
        "tags": [
          "ApiEndpoints"
        ],
        "summary": "Vorstellungen eines Tages (date=YYYY-MM-DD, UTC), ohne Parameter alle kommenden",
        "operationId": "GetShowtimesV2",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ShowtimeListItemV2Dto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v2/showtimes/{id}": {
      "get": {
        "tags": [
          "ApiEndpoints"
        ],
        "summary": "Eine Vorstellung mit Film, Saal, Preis (Betrag und Währung) und Sitzplan-Labels",
        "operationId": "GetShowtimeByIdV2",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShowtimeDetailV2Dto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FilmDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32"
          },
          "ageRating": {
            "type": "integer",
            "format": "int32"
          },
          "description": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PriceDto": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "format": "double"
          },
          "currency": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": { }
      },
      "ShowtimeDetailV2Dto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "film": {
            "$ref": "#/components/schemas/ShowtimeFilmDto"
          },
          "hall": {
            "$ref": "#/components/schemas/ShowtimeHallDto"
          },
          "startsAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "price": {
            "$ref": "#/components/schemas/PriceDto"
          },
          "seatLabels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ShowtimeFilmDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32"
          },
          "ageRating": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "ShowtimeHallDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "rowCount": {
            "type": "integer",
            "format": "int32"
          },
          "seatsPerRow": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "ShowtimeListItemV2Dto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "filmId": {
            "type": "string",
            "format": "uuid"
          },
          "filmTitle": {
            "type": "string",
            "nullable": true
          },
          "hallId": {
            "type": "string",
            "format": "uuid"
          },
          "hallName": {
            "type": "string",
            "nullable": true
          },
          "startsAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "price": {
            "$ref": "#/components/schemas/PriceDto"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
    {
      "name": "ApiEndpoints"
    }
  ]
}